# Canonical u=1 must sample the right edge, not wrap to u=0.
v -1 -1 0
v  1 -1 0
v  1  1 0
v -1  1 0
vt 1 0
vt 1 0
vt 1 1
vt 1 1
# Chosen so the renderer's fixed X/Y presentation transform nearly aligns the
# authored normal with its light; the isolated test can distinguish lighting
# values above 10 without changing this asset's UV-boundary purpose.
vn -0.7507 -0.6340 0.1849
f 1/1/1 2/2/1 3/3/1 4/4/1
