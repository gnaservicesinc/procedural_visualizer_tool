# Closed cube with authored UVs on every side. Each visible ray normally
# produces an entry and exit fragment, making it useful for alpha-layer tests.
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
f 5/1 6/2 7/3 8/4
f 1/1 4/4 3/3 2/2
f 1/1 5/2 8/3 4/4
f 2/1 3/4 7/3 6/2
f 4/1 8/2 7/3 3/4
f 1/1 2/2 6/3 5/4
