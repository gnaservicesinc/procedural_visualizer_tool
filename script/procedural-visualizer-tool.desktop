[Desktop Entry]
Version=1.0
Name=Procedural Visualizer Tool
GenericName=Procedural Animation Editor
Comment=Create seamless looping procedural animations
Exec=procedural-visualizer-tool %f
Terminal=false
Type=Application
StartupNotify=true
MimeType=application/x-procedural-visualizer-tool-project;
Icon=procedural-visualizer-tool
Categories=Graphics;2DGraphics;Qt;
Actions=NewWindow;
Keywords=Animation;Audio;Loop;Procedural;Render;Video;Visualizer;

[Desktop Action NewWindow]
Name=New Window
Exec=procedural-visualizer-tool
